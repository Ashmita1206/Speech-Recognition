# =============================================================================
# Speech Recognition Studio — Environment Configuration Reference
# =============================================================================
# Copy this file to .env for local overrides. Never commit actual .env secrets!
# =============================================================================

# Server Port (default: 5000 for local development, 7860 for container deployment)
PORT=5000

# Whisper Speech Recognition Model Identifier
# Options: large-v3 (default, ~3.1 GB), base (~145 MB), tiny (~75 MB)
# Automatic fallback to 'base' occurs if memory is insufficient on CPU.
WHISPER_MODEL=large-v3

# Hugging Face Model Cache Directory (optional)
# Defaults to project-root '.hf_cache' if left blank.
# Ensure sufficient disk space is available at this path (~3.5 GB for large-v3).
# HF_HOME=D:\SPEECH RECOGNITION\.hf_cache

# Production Security Gate: OS System Command Execution
# Set to 'false' (default) in public web deployments to prevent remote OS command execution.
# Set to 'true' only in private, single-user Linux desktop environments.
ENABLE_SYSTEM_COMMANDS=false

# Optional External Translation Credentials
# NOTE: This API key does NOT accelerate local Whisper speech-to-text inference.
# It only provides an optional authenticated Google Cloud Translation v2 fallback.
# If left blank, the application uses its built-in 3-tier translation engine
# (Google Chrome Dict endpoint, MyMemory API, Google Web) without needing any API key.
# TRANSLATION_API_KEY=your_google_cloud_translation_api_key_here
